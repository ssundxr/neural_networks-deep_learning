import torch
import torch.nn as nn
import torch.optim as optim

X = torch.tensor([[0.5, 0.2, 0.1]])
y = torch.tensor([[1.0]])

class FeedForwardNN(nn.Module):
    def __init__(self):
        super().__init__()
        self.hidden = nn.Linear(3, 2)
        self.output = nn.Linear(2, 1)

    def forward(self, x):
        x = torch.relu(self.hidden(x))   # hidden layer
        x = torch.sigmoid(self.output(x))  # output layer
        return x

model = FeedForwardNN()

criterion = nn.BCELoss()
optimizer = optim.Adam(model.parameters(), lr=0.01)

for _ in range(10):
    optimizer.zero_grad()
    y_pred = model(X)
    loss = criterion(y_pred, y)
    loss.backward()
    optimizer.step()

print("PyTorch prediction:", model(X).detach().numpy())
